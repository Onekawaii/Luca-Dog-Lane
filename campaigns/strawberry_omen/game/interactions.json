        "next_scene": "scene.act4.leftover_catacombs"
      }
    ],
    "scene.act5.hearing_arena_verdict": [
      {
        "id": "invoke_procedure_at_hearing",
        "label": "Invoke Form 9-A and demand findings of fact",
        "kind": "stat_route",
        "hidden_if_locked": true,
        "requires_stats": {
          "bureaucracy": {
            "gte": 6
          }
        },
        "result": "You request findings of fact in triplicate. Orla’s eyes narrow with professional respect.",
        "stat_delta": {
          "bureaucracy": 1
        },
        "npc_delta": {
          "npc.magistrate_orla": 2
        },
        "rule_table": "department_verdict",
        "next_scene": "scene.act5.verdict_vault"
      },
      {
        "id": "ape_objection_at_hearing",
        "label": "Object by slapping the rail and yelling “AWK”",
        "kind": "stat_route",
        "hidden_if_locked": true,
        "requires_stats": {
          "ape_chaos": {
            "gte": 7
          }
        },
        "result": "The chamber records the objection as legally novel. Somewhere, a printer catches fire in sympathy.",
        "stat_delta": {
          "ape_chaos": 1
        },
        "npc_delta": {
          "npc.magistrate_orla": -1
        },
        "triggers_table": "table.system.hearing_reactions",
        "rule_table": "department_verdict",
        "next_scene": "scene.act5.verdict_vault"
      }
    ]
  },
  "item_actions": [
    {
      "id": "use.evidence_bag.wetberry",
      "item_id": "item.evidence_bag_not_my_business",
      "label": "Contain Wetberry",
      "when": {
        "all": [
          {
            "any": [
              {
                "scene": "scene.act1.first_sighting"
              },
              {
                "scene": "scene.act1.first_memo"
              }
            ]
          },
          {
            "not_flags": {
              "wetberry_contained": true
            }
          }
        ]
      },
      "result": "You bag Wetberry without touching it. The plastic fogs from the inside, then goes still.",
      "removes_items": [
        "item.evidence_bag_not_my_business"
      ],
      "grants_items": [
        "item.bagged_wetberry_evidence"
      ],
      "sets_flags": {
