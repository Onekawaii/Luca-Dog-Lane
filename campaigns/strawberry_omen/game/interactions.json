      "sets_flags": {
        "snack_wraiths_resolved": true
      },
      "next_scene": "scene.act3.accountability_completion"
    },
    {
      "id": "use.freezer_blessing.casserole",
      "item_id": "item.freezer_blessing",
      "label": "Cool the Sentient Casserole before speaking",
      "when": {
        "scene": "scene.act4.casserole_throne"
      },
      "result": "The Freezer Blessing lowers the chamber temperature. The Casserole’s rage becomes something closer to conversation.",
      "sets_flags": {
        "casserole_tempered": true
      },
      "npc_delta": {
        "npc.sentient_casserole": 2
      },
      "room_state": {
        "temperature": "negotiable"
      }
    },
    {
      "id": "use.evidence_ledger.hearing",
      "item_id": "item.evidence_ledger",
      "label": "Submit the Evidence Ledger",
      "when": {
        "scene": "scene.act5.hearing_arena_verdict"
      },
      "result": "You submit the ledger as the record of your behavior across the Hive.",
      "npc_delta": {
        "npc.magistrate_orla": 1
      },
      "rule_table": "department_verdict",
      "next_scene": "scene.act5.verdict_vault"
    },
    {
      "id": "use.verdict_seal.press",
      "item_id": "item.verdict_seal",
      "label": "Press the Verdict Seal into the record",
      "when": {
        "scene": "scene.act5.verdict_vault"
      },
      "result": "The seal warms under your thumb. The Hive remembers this version of events now.",
      "sets_flags": {
        "verdict_seal_pressed": true
      },
      "room_state": {
        "record_sealed": true
      }
    }
