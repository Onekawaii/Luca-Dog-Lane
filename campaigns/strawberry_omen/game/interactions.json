  "scene_choices": {
    "scene.act1.first_sighting": [
      {
        "id": "bag_wetberry_now",
        "label": "Seal Wetberry in the Evidence Bag",
        "kind": "item_route",
        "hidden_if_locked": true,
        "requires_items": [
          "item.evidence_bag_not_my_business"
        ],
        "when": {
          "not_flags": {
            "wetberry_contained": true
          }
        },
        "result": "Keith’s bag seals with a disappointed zipper sound. Wetberry stops pulsing. The room becomes measurably less damp.",
        "removes_items": [
          "item.evidence_bag_not_my_business"
        ],
        "grants_items": [
          "item.bagged_wetberry_evidence"
        ],
        "sets_flags": {
          "wetberry_contained": true
        },
        "stat_delta": {
          "moisture_pressure": -2
        },
        "npc_delta": {
          "npc.keith_janitor": 1
        },
        "room_state": {
          "wetberry_status": "contained",
          "wetberry_agitation": 0
        },
        "remove_conditions": [
          "condition.socially_stunned"
        ],
        "triggers_table": "table.system.containment_aftershocks"
      },
      {
        "id": "procedural_stare_check",
        "label": "Assess Wetberry using approved procedural distance",
        "kind": "stat_check",
        "hidden_if_locked": true,
        "requires_stats": {
          "bureaucracy": {
            "gte": 2
          }
        },
        "result": "You attempt a procedural assessment.",
        "check": {
          "when": {
            "stats": {
              "bureaucracy": {
                "gte": 4
              }
            }
          },
          "success": {
            "result": "You identify three separate policy violations without moving closer. Tammy would be almost proud.",
            "sets_flags": {
              "wetberry_risk_assessed": true
            },
            "stat_delta": {
              "bureaucracy": 1
            }
          },
          "failure": {
            "result": "You get halfway through the risk matrix before Wetberry makes eye contact with the spreadsheet. Moisture wins this round.",
            "stat_delta": {
              "moisture_pressure": 1
            },
            "add_conditions": [
              {
                "id": "condition.procedural_static",
                "turns": 2
              }
            ]
          }
        }
      }
    ],
    "scene.act1.keith_corner": [
      {
        "id": "return_from_keith",
        "label": "Return to Wetberry with whatever dignity remains",
        "result": "You return to the central table better equipped and no wiser.",
        "next_scene": "scene.act1.first_sighting"
      }
    ],
    "scene.act1.coffee_counter": [
      {
        "id": "return_from_darla",
        "label": "Return to the central table",
        "result": "Darla goes back to watching the microwave like it owes her money.",
        "next_scene": "scene.act1.first_sighting"
      }
    ],
    "scene.act2.fridge_intro": [
      {
        "id": "wipe_frost_with_damp_napkin",
        "label": "Use the Damp Napkin on the frost seam",
        "kind": "item_route",
        "hidden_if_locked": true,
        "requires_items": [
          "item.damp_napkin"
        ],
        "result": "The napkin absorbs a line of impossible frost. A hidden maintenance diagram appears underneath, and the fridge pressure eases.",
        "sets_flags": {
          "fridge_pressure_vented": true
        },
        "stat_delta": {
          "moisture_pressure": -1,
          "bureaucracy": 1
        },
        "room_state": {
          "frost_seam": "vented"
        },
        "add_conditions": [
          {
            "id": "condition.frost_numb",
            "turns": 1
          }
        ]
      }
    ],
    "scene.act3.vendrick_negotiation": [
      {
        "id": "invoke_form_9a",
        "label": "Invoke Form 9-A: Snack Machine Accountability Waiver",
        "kind": "stat_route",
        "hidden_if_locked": true,
        "when": {
          "all": [
            {
              "flags": {
                "professional_composure": true
              }
            },
            {
              "stats": {
                "bureaucracy": {
                  "gte": 4
                }
              }
            }
          ]
        },
        "result": "Vendrick’s display flashes PROCESSING… then, with visible resentment, dispenses an Accountability Token. Procedure has defeated appetite.",
        "sets_flags": {
          "vendrick_price_named": true,
          "snack_wraiths_resolved": true,
          "accountability_token_obtained": true,
          "form_9a_invoked": true
        },
        "grants_items": [
          "item.accountability_token"
        ],
        "stat_delta": {
          "bureaucracy": 2
        },
        "npc_delta": {
          "npc.vendrick": 2
        },
        "next_scene": "scene.act3.accountability_completion"
      },
      {
        "id": "bite_procedural_seal",
        "label": "Bite the procedural seal until the machine recognizes dominance",
        "kind": "stat_route",
        "hidden_if_locked": true,
        "requires_stats": {
          "ape_chaos": {
            "gte": 5
          }
        },
        "result": "You bite the little plastic compliance seal. Vendrick emits a noise no vending machine should know. A token drops. Nobody wins, but you advance.",
        "sets_flags": {
          "snack_wraiths_resolved": true,
          "accountability_token_obtained": true,
          "procedural_seal_bitten": true
        },
        "grants_items": [
          "item.accountability_token"
        ],
        "stat_delta": {
          "ape_chaos": 2,
          "awkwardness": 1
        },
        "npc_delta": {
          "npc.vendrick": -1
        },
        "add_conditions": [
          {
            "id": "condition.recently_associated",
            "turns": 2
          }
        ],
        "next_scene": "scene.act3.accountability_completion"
      }
    ],
    "scene.act4.condiment_gate": [
      {
        "id": "present_accountability_token_to_gate",
        "label": "Present the Accountability Token as proof of prior nonsense",
        "kind": "item_route",
        "hidden_if_locked": true,
        "requires_items": [
          "item.accountability_token"
        ],
        "result": "The Condiment Guardian studies the token. “Cross-departmental accountability. Distasteful, but valid.” The gate opens.",
        "sets_flags": {
          "condiment_gate_opened": true,
          "condiment_accountability_shortcut": true
        },
        "npc_delta": {
          "npc.condiment_guardian": 1
