  "rule_tables": {
    "department_verdict": [
      {
        "id": "exonerated_clean_record",
        "when": {
          "all": [
            {
              "flags": {
                "evidence_gathered": true,
                "testimony_given": true
              }
            },
            {
              "item": "item.evidence_ledger"
            },
            {
              "npc": {
                "id": "npc.bailiff_gorrum",
                "gte": 1
              }
            },
            {
              "not": {
                "any": [
                  {
                    "flags": {
                      "casserole_insulted": true
                    }
                  },
                  {
                    "flags": {
                      "vendrick_insulted": true
                    }
                  },
                  {
                    "flags": {
                      "condiment_guardian_insulted": true
                    }
                  },
                  {
                    "flags": {
                      "frozen_meals_disrespected": true
                    }
                  }
                ]
              }
            }
          ]
        },
        "result": "Orla cross-checks the ledger against Gorrum’s testimony notes. “Messy, yes. Malicious, no.” VERDICT: EXONERATED WITH ANNOTATIONS.",
        "sets_flags": {
          "verdict_rendered": true,
          "verdict_exonerated": true,
          "department_verdict": "exonerated"
        },
        "npc_delta": {
          "npc.magistrate_orla": 2
        }
      },
      {
        "id": "procedural_exoneration",
        "when": {
          "all": [
            {
              "flags": {
                "evidence_gathered": true
              }
            },
            {
              "stats": {
                "bureaucracy": {
                  "gte": 8
                }
              }
            }
          ]
        },
        "result": "Your paperwork forms a defensive wall six binders thick. Orla cannot find a procedural opening. VERDICT: EXONERATED BY EXCESSIVE COMPLIANCE.",
        "sets_flags": {
          "verdict_rendered": true,
          "verdict_exonerated": true,
          "department_verdict": "procedural_exoneration"
        }
      },
      {
        "id": "cosmic_compromise_feral",
        "when": {
          "stats": {
            "ape_chaos": {
              "gte": 8
            }
          }
        },
        "result": "The hearing cannot classify what you did without creating three new departments. Orla sighs. VERDICT: COSMIC COMPROMISE. You are released under aggressive ambiguity.",
        "sets_flags": {
          "verdict_rendered": true,
          "verdict_cosmic_compromise": true,
          "department_verdict": "cosmic_compromise"
        }
      },
      {
        "id": "guilty_pattern",
        "when": {
          "all": [
            {
              "any": [
                {
                  "flags": {
                    "casserole_insulted": true
                  }
                },
                {
                  "flags": {
                    "vendrick_insulted": true
                  }
                },
                {
                  "flags": {
                    "condiment_guardian_insulted": true
                  }
                }
              ]
            },
            {
              "not": {
                "flags": {
                  "evidence_gathered": true
                }
              }
            }
          ]
        },
        "result": "Orla reads the accumulated complaints. There is no ledger to contradict them. VERDICT: GUILTY OF REPEATED PROCEDURAL WEIRDNESS. Sentence: continued employment.",
        "sets_flags": {
          "verdict_rendered": true,
          "verdict_guilty": true,
          "department_verdict": "guilty"
        },
        "add_conditions": [
          {
            "id": "condition.under_scrutiny",
            "turns": -1
          }
        ]
      },
      {
        "id": "cosmic_compromise_default",
        "default": true,
        "result": "The evidence points in several mutually embarrassing directions. Orla stamps the file diagonally. VERDICT: COSMIC COMPROMISE.",
        "sets_flags": {
          "verdict_rendered": true,
          "verdict_cosmic_compromise": true,
          "department_verdict": "cosmic_compromise"
        }
      }
    ]
  }
}
